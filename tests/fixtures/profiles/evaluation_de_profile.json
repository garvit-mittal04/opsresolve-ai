{
  "profile_version": 1,
  "name": "Reformatted evaluation set, German ERP layout (test fixture)",
  "defaults": {
    "delimiter": ";",
    "encoding": "cp1252",
    "date_format": "DD.MM.YYYY",
    "decimal_separator": ",",
    "thousands_separator": "."
  },
  "files": {
    "purchase_orders": {
      "columns": {
        "po_number": "Bestellnummer", "line_number": "Position", "supplier_id": "Lieferantennummer",
        "supplier_name": "Lieferantenname", "sku": "Artikelnummer", "description": "Bezeichnung",
        "quantity_ordered": "Bestellmenge", "unit_price": "Stückpreis", "currency": "Währung",
        "order_date": "Bestelldatum", "unit_of_measure": "Mengeneinheit"
      }
    },
    "invoices": {
      "columns": {
        "invoice_number": "Rechnungsnummer", "invoice_date": "Rechnungsdatum", "supplier_id": "Lieferantennummer",
        "po_number": "Bestellnummer", "sku": "Artikelnummer", "quantity_invoiced": "Berechnete Menge",
        "unit_price": "Stückpreis", "currency": "Währung", "unit_of_measure": "Mengeneinheit"
      }
    },
    "goods_received": {
      "columns": {
        "grn_number": "Wareneingangsnummer", "received_date": "Eingangsdatum", "supplier_id": "Lieferantennummer",
        "po_number": "Bestellnummer", "sku": "Artikelnummer", "quantity_received": "Gelieferte Menge (Stück)",
        "unit_of_measure": "Mengeneinheit"
      }
    },
    "uom_conversions": {
      "columns": {
        "sku": "Artikelnummer", "uom": "Einheit", "base_uom": "Basiseinheit", "units_per_uom": "Stück je Einheit"
      }
    }
  }
}
