# OpsResolve AI - example environment configuration.
# Copy to .env and adjust. Never commit a real .env file.
#
# The engine is fully deterministic and needs no API keys.
# Matching tolerances and severity thresholds can be overridden here.

OPSRESOLVE_PRICE_TOLERANCE_PCT=0.0
OPSRESOLVE_PRICE_TOLERANCE_ABS=0.00
OPSRESOLVE_QUANTITY_TOLERANCE=0
OPSRESOLVE_DUPLICATE_WINDOW_DAYS=30
OPSRESOLVE_HIGH_SEVERITY_AMOUNT=1000.00
OPSRESOLVE_MEDIUM_SEVERITY_AMOUNT=100.00

# Optional AI explanations (opsresolve.ai, needs pip install -e ".[ai]"). Narrative only, never calculations.
# Without ANTHROPIC_API_KEY nothing is sent and explanations report "not_configured".
# ANTHROPIC_LOG=debug does not log OpsResolve's requests: while one is made, the SDK's and HTTP libraries'
# records below WARNING are dropped for that thread (they could hold the request body and headers).
# ANTHROPIC_API_KEY=
# OPSRESOLVE_AI_MODEL=claude-opus-5-5
# OPSRESOLVE_AI_EFFORT=medium
# The web app uses 120 seconds and no retries unless these two are set; other callers default to 300 and 2.
# OPSRESOLVE_AI_TIMEOUT_SECONDS=300
# OPSRESOLVE_AI_MAX_RETRIES=2
# Thinking counts toward this cap on claude-opus-5-5; only tokens actually generated are billed.
# OPSRESOLVE_AI_MAX_TOKENS=16000
